{
  "name": "codex-product-experience-agent",
  "version": "0.1.0",
  "description": "A Codex-native product experience audit agent for repeatable UX journeys, evidence collection, and repair loops.",
  "type": "module",
  "bin": {
    "codex-ux": "./src/cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "audit": "node src/cli.mjs audit",
    "example:codenext": "node src/cli.mjs audit --config examples/codenext --url http://127.0.0.1:3599 --user ${CODEX_UX_USER:-admin} --pass ${CODEX_UX_PASS:-}",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "codex",
    "ux-audit",
    "playwright",
    "product-experience",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@playwright/test": "^1.60.0"
  },
  "devDependencies": {}
}
